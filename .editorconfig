root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,neon,json}]
indent_size = 4

[.github/**.yml]
indent_size = 2

# The inherited PhpGedView code keeps its own formatting until a file is rewritten.
[app/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
